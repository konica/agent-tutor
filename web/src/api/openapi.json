{
  "components": {
    "schemas": {
      "AskRequest": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "DocumentResponse": {
        "properties": {
          "attempt": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attempt"
          },
          "can_retry": {
            "title": "Can Retry",
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "max_attempts": {
            "title": "Max Attempts",
            "type": "integer"
          },
          "state": {
            "enum": [
              "processing",
              "awaiting_subjects",
              "ready",
              "failed"
            ],
            "title": "State",
            "type": "string"
          },
          "subjects": {
            "items": {
              "$ref": "#/components/schemas/SubjectResponse"
            },
            "title": "Subjects",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "title",
          "state",
          "failure_reason",
          "attempt",
          "max_attempts",
          "can_retry",
          "created_at",
          "subjects"
        ],
        "title": "DocumentResponse",
        "type": "object"
      },
      "DuplicateCheckRequest": {
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "sha256"
        ],
        "title": "DuplicateCheckRequest",
        "type": "object"
      },
      "DuplicateCheckResponse": {
        "properties": {
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          }
        },
        "required": [
          "document_id"
        ],
        "title": "DuplicateCheckResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "name",
          "roles"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "StartUploadRequest": {
        "additionalProperties": false,
        "properties": {
          "file_name": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "File Name",
            "type": "string"
          }
        },
        "required": [
          "file_name"
        ],
        "title": "StartUploadRequest",
        "type": "object"
      },
      "StartUploadResponse": {
        "properties": {
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Fields",
            "type": "object"
          },
          "upload_id": {
            "title": "Upload Id",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "upload_id",
          "url",
          "fields"
        ],
        "title": "StartUploadResponse",
        "type": "object"
      },
      "SubjectMatchResponse": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "origin": {
            "enum": [
              "yours",
              "shared"
            ],
            "title": "Origin",
            "type": "string"
          },
          "subject_id": {
            "title": "Subject Id",
            "type": "string"
          }
        },
        "required": [
          "subject_id",
          "name",
          "origin"
        ],
        "title": "SubjectMatchResponse",
        "type": "object"
      },
      "SubjectResponse": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "subject_id": {
            "title": "Subject Id",
            "type": "string"
          }
        },
        "required": [
          "subject_id",
          "name"
        ],
        "title": "SubjectResponse",
        "type": "object"
      },
      "SubjectSuggestionsResponse": {
        "properties": {
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/SuggestionResponse"
            },
            "title": "Suggestions",
            "type": "array"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "title",
          "summary",
          "suggestions"
        ],
        "title": "SubjectSuggestionsResponse",
        "type": "object"
      },
      "SuggestionResponse": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "origin": {
            "enum": [
              "shared",
              "yours",
              "new"
            ],
            "title": "Origin",
            "type": "string"
          },
          "subject_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject Id"
          }
        },
        "required": [
          "subject_id",
          "name",
          "origin"
        ],
        "title": "SuggestionResponse",
        "type": "object"
      },
      "ThreadResponse": {
        "properties": {
          "awaiting_subjects": {
            "title": "Awaiting Subjects",
            "type": "boolean"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "subjects": {
            "items": {
              "$ref": "#/components/schemas/SubjectResponse"
            },
            "title": "Subjects",
            "type": "array"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "question",
          "subjects",
          "awaiting_subjects"
        ],
        "title": "ThreadResponse",
        "type": "object"
      },
      "UploadLimitsResponse": {
        "properties": {
          "max_bytes": {
            "title": "Max Bytes",
            "type": "integer"
          },
          "max_pages": {
            "title": "Max Pages",
            "type": "integer"
          }
        },
        "required": [
          "max_bytes",
          "max_pages"
        ],
        "title": "UploadLimitsResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "smart_tutor__apps__api__routes__knowledge__ChooseSubjectsRequest": {
        "additionalProperties": false,
        "properties": {
          "new_names": {
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 3,
            "title": "New Names",
            "type": "array"
          },
          "subject_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 3,
            "title": "Subject Ids",
            "type": "array"
          }
        },
        "title": "ChooseSubjectsRequest",
        "type": "object"
      },
      "smart_tutor__apps__api__routes__threads__ChooseSubjectsRequest": {
        "additionalProperties": false,
        "properties": {
          "subject_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Subject Ids",
            "type": "array"
          }
        },
        "required": [
          "subject_ids"
        ],
        "title": "ChooseSubjectsRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Smart Tutor API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/documents": {
      "get": {
        "operationId": "list_documents",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentResponse"
                  },
                  "title": "Response List Documents",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Documents",
        "tags": [
          "knowledge"
        ]
      }
    },
    "/documents/duplicate-check": {
      "post": {
        "description": "Whether the caller's own library already holds this file, so the browser can skip the upload (PRD \u00a78 US-2).\n\nAnother learner's copy is never reported or linked; the server-side hash decides after upload (D19).",
        "operationId": "check_duplicate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DuplicateCheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DuplicateCheckResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Check Duplicate",
        "tags": [
          "knowledge"
        ]
      }
    },
    "/documents/{document_id}/retry": {
      "post": {
        "description": "Process a failed document's stored file again (PRD \u00a79.5); a document that isn't failed is left as it is.",
        "operationId": "retry_document",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Retry Document",
        "tags": [
          "knowledge"
        ]
      }
    },
    "/documents/{document_id}/subject-suggestions": {
      "get": {
        "description": "Three ranked subjects for a processed document, for the learner to choose from (PRD \u00a78 US-2b).",
        "operationId": "get_subject_suggestions",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubjectSuggestionsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Subject Suggestions",
        "tags": [
          "knowledge"
        ]
      }
    },
    "/documents/{document_id}/subjects": {
      "put": {
        "description": "Save the learner's 1-3 subjects; the document becomes ready to use (PRD \u00a78 US-2b).",
        "operationId": "choose_subjects",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/smart_tutor__apps__api__routes__knowledge__ChooseSubjectsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Choose Subjects",
        "tags": [
          "knowledge"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Me",
        "tags": [
          "accounts"
        ]
      }
    },
    "/me/subjects": {
      "get": {
        "operationId": "list_my_subjects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SubjectResponse"
                  },
                  "title": "Response List My Subjects",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List My Subjects",
        "tags": [
          "subjects"
        ]
      }
    },
    "/subjects/search": {
      "get": {
        "description": "The caller's subjects matching `q` (by their names), then other shared subjects (canonical names).",
        "operationId": "search_subjects",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SubjectMatchResponse"
                  },
                  "title": "Response Search Subjects",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Search Subjects",
        "tags": [
          "subjects"
        ]
      }
    },
    "/threads": {
      "post": {
        "operationId": "ask_in_new_thread",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Server-sent events: thread, then delta*, citations, done (or error). A new thread may instead open with choose_subjects, then done."
          },
          "409": {
            "description": "The learner has no ready documents."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Ask In New Thread",
        "tags": [
          "tutoring"
        ]
      }
    },
    "/threads/{thread_id}": {
      "get": {
        "operationId": "get_thread",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "title": "Thread Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Thread",
        "tags": [
          "tutoring"
        ]
      }
    },
    "/threads/{thread_id}/subjects": {
      "post": {
        "description": "The learner's pick for a thread waiting for its subjects; the agent then answers the first question.",
        "operationId": "choose_thread_subjects",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "title": "Thread Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/smart_tutor__apps__api__routes__threads__ChooseSubjectsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Server-sent events: thread, then delta*, citations, done (or error)."
          },
          "404": {
            "description": "No such conversation."
          },
          "409": {
            "description": "The conversation already has its subjects, or the tutor has no question waiting."
          },
          "422": {
            "description": "The pick is not 1 to 3 distinct subjects of the learner's own."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Choose Thread Subjects",
        "tags": [
          "tutoring"
        ]
      }
    },
    "/uploads": {
      "post": {
        "operationId": "start_upload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartUploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Start Upload",
        "tags": [
          "knowledge"
        ]
      }
    },
    "/uploads/limits": {
      "get": {
        "description": "The per-file limits, so the browser can refuse a file before uploading it (PRD \u00a78 US-2).",
        "operationId": "get_upload_limits",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadLimitsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Upload Limits",
        "tags": [
          "knowledge"
        ]
      }
    }
  }
}
