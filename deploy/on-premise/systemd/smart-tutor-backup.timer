# 03:00 in the app's time zone (Asia/Ho_Chi_Minh), an hour after the data volume's snapshot (HostStack). Persistent
# runs a night missed while the VM was off as soon as it boots.
[Unit]
Description=Smart Tutor: back up the databases nightly

[Timer]
OnCalendar=*-*-* 20:00:00 UTC
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
