# On-premise edge (#148, ADR 0012): HTTPS for SMART_TUTOR_DOMAIN with a Let's Encrypt certificate (HTTP redirects to
# it), and one origin with path routing, as CloudFront does in native-cloud mode. Caddy sets X-Forwarded-Proto and
# X-Forwarded-Host itself and ignores ones a client sends, so Keycloak can trust them (KC_PROXY_HEADERS=xforwarded).
# The API is served under /api and Keycloak under /auth, so neither path is stripped.
{
	servers {
		# The security group opens TCP 80 and 443 only: no HTTP/3 over UDP.
		protocols h1 h2
	}
}

{$SMART_TUTOR_DOMAIN} {
	handle /api/* {
		# Answers stream as server-sent events; Caddy flushes them as they come.
		reverse_proxy api:8080
	}
	handle /auth/* {
		reverse_proxy keycloak:8080
	}
	handle {
		reverse_proxy web:8080
	}
}
