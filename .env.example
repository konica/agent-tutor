# Copy to .env (never commit .env). Settings use the SMART_TUTOR_ prefix; nested keys use __.

# AWS: local runs call the real us-east-1 Bedrock models with a developer profile (PRD §9.12).
AWS_PROFILE=smart-tutor-dev
AWS_REGION=us-east-1
SMART_TUTOR_AWS_REGION=us-east-1

# LangSmith: use a separate local project.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-tutor-local

# Local dependency services (docker compose up -d)
SMART_TUTOR_DATABASE_URL=postgresql+psycopg://smart_tutor:smart_tutor@localhost:5432/smart_tutor
SMART_TUTOR_KEYCLOAK_ISSUER=http://localhost:8080/realms/smart-tutor
SMART_TUTOR_DOCUMENTS_BUCKET=smart-tutor-documents
SMART_TUTOR_INGEST_QUEUE_URL=http://localhost:4566/000000000000/smart-tutor-ingest
SMART_TUTOR_MCP_URL=http://localhost:8000/mcp
AWS_ENDPOINT_URL_S3=http://localhost:4566
AWS_ENDPOINT_URL_SQS=http://localhost:4566
AWS_ENDPOINT_URL_SSM=http://localhost:4566

# Model roles (defaults in smart_tutor/shared/config.py)
# SMART_TUTOR_MODELS__AGENT__MODEL_ID=us.amazon.nova-2-lite-v1:0
