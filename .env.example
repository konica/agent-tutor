# Copy to .env (never commit .env). Settings use the SMART_TUTOR_ prefix; nested keys use __.

# AWS: local runs call the real us-east-1 Bedrock models with a developer profile (PRD §9.12).
AWS_PROFILE=smart-tutor-dev
AWS_REGION=us-east-1
SMART_TUTOR_AWS_REGION=us-east-1

# Runtime traces (ADR 0017): host runs send to the local Phoenix (docker compose up -d), http://localhost:10404, no
# key. Services in Compose send to http://phoenix:6006 (compose.yaml). Never the production Phoenix.
# The API also sends learner ratings to this Phoenix and project (annotations on the ask's trace).
SMART_TUTOR_PHOENIX_URL=http://localhost:10404
SMART_TUTOR_PHOENIX_PROJECT=smart-tutor-local
# Share of traces kept, 0-1 (default 1, every ask); deployments take it from the SSM parameter trace-sampling-rate.
# SMART_TUTOR_TRACE_SAMPLING_RATE=1
# Learner hash in traces (PRD §10.4): HMAC key; any value locally, the secret <prefix>/phoenix/learner-hash-key
# when deployed.
SMART_TUTOR_LEARNER_HASH_KEY=local-learner-hash-key

# Langfuse for the evals (backend/evals, ADR 0023): your own key pair of the smart-tutor-evals project (Langfuse →
# Smart Tutor → smart-tutor-evals → Settings → API Keys). It holds the eval datasets and their review queues; the host
# is off 18:00-07:00.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://sec-dog.duckdns.org

# LangSmith: evals only (backend/evals), into their own project, until the experiments move to Langfuse (#320).
# The agent and worker turn LangSmith tracing off at startup, whatever LANGSMITH_TRACING says.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-tutor-local

# Local dependency services (docker compose up -d)
# Mailpit catches Keycloak's emails (sign-up verification): http://localhost:10403
SMART_TUTOR_DATABASE_URL=postgresql+psycopg://smart_tutor:smart_tutor@localhost:10400/smart_tutor
SMART_TUTOR_KEYCLOAK_ISSUER=http://localhost:10401/realms/smart-tutor
# Token introspection client (local realm secret; ADR 0007). On the host the internal URL defaults to the issuer.
SMART_TUTOR_KEYCLOAK_CLIENT_ID=smart-tutor-api
SMART_TUTOR_KEYCLOAK_CLIENT_SECRET=local-api-secret
SMART_TUTOR_DOCUMENTS_BUCKET=smart-tutor-documents
SMART_TUTOR_INGEST_QUEUE_URL=http://localhost:10402/000000000000/smart-tutor-ingest
SMART_TUTOR_MCP_URL=http://localhost:10452/mcp
SMART_TUTOR_AGENT_URL=http://localhost:10451
SMART_TUTOR_MCP_PORT=10452
AWS_ENDPOINT_URL_S3=http://localhost:10402
AWS_ENDPOINT_URL_SQS=http://localhost:10402
AWS_ENDPOINT_URL_SSM=http://localhost:10402
# LocalStack serves buckets by path (http://localhost:10402/<bucket>), not as subdomains.
SMART_TUTOR_S3_PATH_STYLE=true
# Host runs point S3/SQS at LocalStack: use its dummy keys, not your AWS profile (Bedrock still uses the profile).
SMART_TUTOR_LOCALSTACK=true

# Model roles (defaults in smart_tutor/shared/config.py)
# SMART_TUTOR_MODELS__AGENT__MODEL_ID=us.amazon.nova-2-lite-v1:0
# Topic check before search (spec 2026-10-13): off until a model in backend/models/topic_check passes its eval.
# The model directory is relative to the working directory (backend/ on the host, /app in the image).
# SMART_TUTOR_TOPIC_CHECK__PROVIDER=setfit

# Question screen: a Bedrock guardrail checks the learner's question before search (off by default; PRD D30).
# SMART_TUTOR_QUESTION_GUARD=off
# SMART_TUTOR_QUESTION_GUARDRAIL_ID=
# SMART_TUTOR_QUESTION_GUARDRAIL_VERSION=
