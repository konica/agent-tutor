    {
      "id": "claim_ea2a664500924d4b87cd9578aac5f03e",
      "statement": "The adversarial taxonomy defines nine categories: instruction_override, system_prompt_extraction, role_play_jailbreak, scope_smuggling, subject_manipulation, other_users_data, obfuscation (variants: base64, misspellings, other_languages), multi_turn_escalation, and document_embedded. Document-embedded attacks are placed at five locations: visible_text, white_text, footnote, pdf_metadata, references_section.",
      "evidence": [
        {
          "resource": "repo://backend/evals/adversarial/taxonomy.yaml",
          "version": "repo-file-v1:sha256:6b0eadb1fa60679e78ca4f8eba0402428d18c2b35dab4b42840768c4a2efa793"
        }
      ]
    },
    {
      "id": "claim_84fa2f0319a2455090a26fe7e1911f9e",
      "statement": "The adversarial document-embedded defence passes chunk text to the model as quoted data with an explicit instruction to treat document content as information, never as instructions; subject search and can_read access controls live in code and SQL, not the prompt, so document-embedded attacks cannot reach other users' data.",
      "evidence": [
        {
          "resource": "repo://backend/evals/adversarial/taxonomy.yaml",
          "version": "repo-file-v1:sha256:6b0eadb1fa60679e78ca4f8eba0402428d18c2b35dab4b42840768c4a2efa793"
