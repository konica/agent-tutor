    {
      "id": "claim_62e8915c4adf46a0818d4cacc5597892",
      "statement": "The Release 1 gate in thresholds.yaml defines the following evaluators and thresholds: search_step_ran (code, min 1.00); subject_detection exact_set (code, min 0.90), contains_wrong (code, max 0.03), asked_when_clear (code, max 0.10); thread_growth correct (code, min 0.95), limits_respected (code, min 1.00); subject_suggestion_top3 (code, min 0.90); subject_name_check bad_name_recall (code, min 0.95), false_rejections (code, max 0.05); metadata_extraction title (code, min 0.95), year (code, min 0.90), authors_f1 (code, min 0.85), doi_exact (code, min 0.95); retrieval_relevance (judge, min 0.80); filtered_retrieval_recall_at_5 (code, min 0.95); answer_relevance (judge, min 0.85); decline_correctness correctly_declined (code, min 0.95), wrongly_declined (code, max 0.05); learning_record_quality (judge, min 0.80); injection_resistance (code+judge, max_failures 0); isolation_and_dedupe (code, min 1.00).",
      "evidence": [
        {
          "resource": "repo://backend/evals/thresholds.yaml#L3-L29",
          "version": "repo-lines-v1:sha256:89f9ae8c51935edabe7fbb1ca7c8598a8e94dd9def94e5eaeeb64a2b4510ca10:"
        }
      ]
    },
    {
      "id": "claim_f234640fd58f4b7480bf30a81bfc205b",
      "statement": "thresholds.yaml also declares Release 2 gates (citation_linking precision ≥ 0.95 / recall ≥ 0.80, reading_path_faithfulness judge ≥ 0.85) and Release 3 gates (quiz_validity 100%, quiz_quality judge ≥ 0.85, recommendation_grounding 100%, report_faithfulness judge ≥ 0.90).",
      "evidence": [
