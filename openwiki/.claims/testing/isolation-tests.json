    {
      "id": "claim_f30e9a3a7d8943bbac6d98b4d0b8a59c",
      "statement": "A duplicate upload links to existing content without creating new chunks: when any learner uploads a file whose server-computed SHA-256 matches an existing content, the uploaded copy is discarded, the learner's document is linked to the existing content row, and no extraction or embedding runs.",
      "evidence": [
        {
          "resource": "repo://sdd/prd.md#L113-L113",
          "version": "repo-lines-v1:sha256:c5f91d880ea0a5f78781f0536c65c40e9bcce5b08b57d4208ebc98dcc6938ac0:"
