    {
      "id": "claim_68c3d875b69e410b8e6fe2e86b3e5aa8",
      "statement": "A browser-supplied SHA-256 hash alone never causes the system to link a learner's document to existing content; linking only happens after the server recomputes the hash from the uploaded bytes, preventing access to another learner's private file by knowing its hash (PRD D19).",
      "evidence": [
        {
          "resource": "repo://sdd/prd.md#L114-L114",
          "version": "repo-lines-v1:sha256:f087e731b3fb42329b24b8adaca2b830b5ca6415936c4c19f2cc7b277f771b80:"
