    {
      "id": "claim_13bf88634bf742d5ac917175595ede27",
      "statement": "FakeChatModel.stream delegates to invoke, then yields word-by-word ChatChunk(text=…) chunks (split on spaces), followed by one ChatChunk(tool_call=…) per tool call, and finally ChatChunk(usage=…) as the last chunk.",
