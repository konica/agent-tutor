    {
      "id": "claim_25d44fa6c38144488a38ba26de727528",
      "statement": "The realm is only imported when it does not yet exist in the Keycloak database. After editing realm-smart-tutor.json, volumes must be destroyed with 'docker compose down -v' to force re-import.",
