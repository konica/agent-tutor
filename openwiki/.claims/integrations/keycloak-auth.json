    {
      "id": "claim_9c1237d915834f0d998bd3b0bc1eeff0",
      "statement": "Tokens travel only in HTTP headers and runtime context and must never appear in prompts, logs, or traces. This is a project-level invariant (AGENTS.md and PRD §9.3) that protects the access-control boundary from LLM exposure.",
