        }
      ]
    },
    {
      "id": "claim_885b1bc5b42f407a93f67d058260077f",
      "statement": "Settings supplies keycloak_issuer (default: http://localhost:8080/realms/smart-tutor) and keycloak_audience (default: smart-tutor-api) read from environment variables with prefix SMART_TUTOR_ and nested delimiter __.",
