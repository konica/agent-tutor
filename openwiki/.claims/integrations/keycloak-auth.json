    {
      "id": "claim_d4c98351abe2485ea2292506873533d1",
      "statement": "The realm defines two application roles: 'learner' (default for all self-registered users, assigned via the default-roles-smart-tutor composite role) and 'admin' (operations only: cost/budget alerts, evaluation annotation; no product admin functions in Releases 1–3).",
      "evidence": [
