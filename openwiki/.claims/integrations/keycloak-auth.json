    {
      "id": "claim_a0e414e94d9646eda1bd50e37224624d",
      "statement": "Self-registration is enabled on the smart-tutor realm (registrationAllowed: true); new users automatically receive the learner role through the default-roles-smart-tutor composite role without manual assignment.",
      "evidence": [
