        }
      ]
    },
    {
      "id": "claim_4d38ec0403cb4a729419b7e277d5c2ad",
      "statement": "The ingestion worker (`apps/worker/main.py`) polls `smart-tutor-ingest`, downloads each uploaded PDF from S3, and runs the processing pipeline (validation, SHA-256, deduplication or content creation, Docling extraction, chunking, and embedding); the pipeline is an M1 task and currently raises `NotImplementedError`.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/apps/worker/main.py",
          "version": "repo-file-v1:sha256:7ba03cdea573c4b900378a20ccd962d35f8d0430fcef8aec475ec6afad3c990b"
        }
