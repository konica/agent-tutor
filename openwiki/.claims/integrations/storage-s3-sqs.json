          "version": "repo-lines-v1:sha256:96fcd568c5a0f0a097f0b816b5fe7fa056fa9943109435fea4db2ec9cd05655c:"
        }
      ]
    },
    {
      "id": "claim_012e30ed5593452fbff9daa3608be7c1",
      "statement": "An S3 bucket notification sends `s3:ObjectCreated:*` events scoped to the `uploads/` prefix to the `smart-tutor-ingest` SQS queue; objects written under `contents/` do not trigger notifications. A dead-letter queue `smart-tutor-ingest-dlq` receives messages after repeated processing failures.",
      "evidence": [
        {
          "resource": "repo://local/localstack/init/ready.d/10-smart-tutor.sh#L13-L28",
          "version": "repo-lines-v1:sha256:a49215e434a5b25db8f0e37fbced90285e2071e0ce87ea0ad0876495f2cacd8b:"
