    {
      "id": "claim_b07511d9911f47b381ba7170cd6699c9",
      "statement": "The `glacier_tagger` CronJob (`apps/jobs/glacier_tagger.py`) runs daily, tags `contents/<sha256>.pdf` objects with `status=archived` when no non-archived document references the content, and removes the tag when a document becomes active again; an S3 lifecycle rule then moves tagged objects to Glacier Flexible Retrieval after 30 days. The CronJob is an M1 task.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/apps/jobs/glacier_tagger.py",
