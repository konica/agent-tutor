  "claims": [
    {
      "id": "claim_1ab1a8bd364a43e68666aef7887b2eca",
      "statement": "Smart Tutor uses a single S3 bucket named `smart-tutor-documents` with two key prefixes: `uploads/<user_id>/<upload_id>.pdf` for raw learner uploads (presigned POST, 1-day lifecycle expiry) and `contents/<sha256>.pdf` for deduplicated permanent content files; `contents/<sha256>.docling.json` stores the saved Docling extraction output alongside each content.",
      "evidence": [
        {
          "resource": "repo://infra/smart_tutor_infra/stacks/storage.py#L1-L3",
          "version": "repo-lines-v1:sha256:f958561cdfbfca7a5c26b849951aa1b55b880df09e462c141006e90ffc230177:"
        },
        {
          "resource": "repo://local/localstack/init/ready.d/10-smart-tutor.sh#L6-L11",
