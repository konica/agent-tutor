        }
      ]
    },
    {
      "id": "claim_ecee3f41ca6f42e582e94b688eb8533b",
      "statement": "The API issues a presigned POST for `uploads/<user_id>/<upload_id>.pdf` with a `content-length-range` condition capping uploads at 50 MB and a `Content-Type` condition requiring `application/pdf`; the policy expires after 1 day and the key binds the upload to the authenticated user.",
      "evidence": [
        {
          "resource": "repo://infra/smart_tutor_infra/stacks/storage.py#L1-L3",
          "version": "repo-lines-v1:sha256:f958561cdfbfca7a5c26b849951aa1b55b880df09e462c141006e90ffc230177:"
        },
