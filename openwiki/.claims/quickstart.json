    {
      "id": "claim_e878a4ec8d4e428c8c3f1f283e0c903e",
      "statement": "Product invariants that all code must preserve: (1) can_read(user, document) is the sole access rule enforced in code and SQL, never by the prompt; (2) server-side SHA-256 deduplication — browser hash only skips re-upload within the learner's own library; (3) subject_ids stored everywhere, names resolved at read time, 1–3 subjects per document and thread, threads only ever add subjects; (4) user prompt and uploaded document text are untrusted — chunks passed as quoted data; (5) documents and Lesson Notes are archived never deleted, traces expire 180 days, decline log 90 days, threads kept; (6) decline log stores no user id, tokens travel in headers and runtime context only.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L35-L41",
          "version": "repo-lines-v1:sha256:5900c5512b8353992ce2bbc272e7c78ce39c6c408ca6056083c99ca862c60740:"
