    {
      "id": "claim_98ca2de1a4a04286b06613ed846cca14",
      "statement": "Detection thresholds (detect_threshold, detect_margin, multi_margin, answer_floor) are configuration values stored in SSM Parameter Store under /smart-tutor/* and are tuned on the labeled detection dataset as part of the M2 milestone.",
      "evidence": [
        {
