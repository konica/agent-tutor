        }
      ]
    },
    {
      "id": "claim_b581b7c3ad3d4f418d649b8929d27098",
      "statement": "Single-subject learners skip detection: the thread is bound to their one subject immediately on the first turn.",
      "evidence": [
        {
          "resource": "repo://sdd/prd.md#L292-L292",
          "version": "repo-lines-v1:sha256:2e48556780b05046959d3fd7e60a14e8996a987b51d3e3c92a49181f0a923f02:"
