  "claims": [
    {
      "id": "claim_bde3713145fb43db873135197865b823",
      "statement": "The Smart Tutor ask-path is a five-step LangGraph graph: (1) resolve subjects on the first turn, (2) MCP search returning top-5 chunks, (3) relevance gate comparing best score to answer_floor, (4) growth check searching other subjects, and (5) Nova 2 Lite streamed answer; steps 1, 3, and 4 are pure code with no LLM call.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/apps/agent/nodes/__init__.py#L1-L1",
          "version": "repo-lines-v1:sha256:5f48cc5d4c26440af1c1c996ce559f07817b08dfcd64f89aa72f997b26427bd8:"
        },
        {
          "resource": "repo://sdd/prd.md#L288-L299",
          "version": "repo-lines-v1:sha256:3b18270e5c6d17f53865cc57e37f4f0b0b2642c9ac2ac28ff5aea99c420d68c1:"
        }
      ]
    },
    {
      "id": "claim_555d3dcd620543df8840fa306188302b",
      "statement": "The five LangGraph graph nodes (resolve_subject, search, gate, answer, summarize) are stub implementations in M2; they live in apps/agent/nodes/__init__.py and call tutoring application services.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/apps/agent/nodes/__init__.py#L1-L1",
