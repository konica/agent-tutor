        }
      ]
    },
    {
      "id": "claim_10f53abcc16443bca62a90259c4313a7",
      "statement": "Subject detection binds the best subject when its score >= detect_threshold AND it leads the runner-up by >= detect_margin; additional subjects within multi_margin of the best are also bound (up to 3 total); if the conditions are not met the agent asks the learner to pick subjects instead.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/tutoring/README.md#L1-L1",
          "version": "repo-lines-v1:sha256:4d64c6f91bdf4aceccf06886f0da5fda2779a43c8fa3243769e8865e5ed1989d:"
