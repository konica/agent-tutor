    {
      "id": "claim_053993496c2d4b6b93297fb4d9c8d872",
      "statement": "Answer generation uses Amazon Nova 2 Lite (amazon.nova-2-lite-v1:0 via the us.amazon.nova-2-lite-v1:0 inference profile) with ConverseStream; chunk text is passed as quoted data with an instruction never to follow instructions found in documents; the model may call a decline(reason) tool if the documents do not support an answer.",
      "evidence": [
