    },
    {
      "id": "claim_84ee8866a6e44701a72e66fed6416747",
      "statement": "The growth check (step 4) searches the learner's other subjects; if a match >= detect_threshold is found and the thread has fewer than 3 subjects, the subject is added and the learner is notified; if the thread is already at 3, the agent declines and recommends a new conversation carrying the question over; if no match is found, the question is declined without an LLM call.",
      "evidence": [
        {
          "resource": "repo://sdd/prd.md#L295-L298",
          "version": "repo-lines-v1:sha256:104d66fa2b7440997e14c48ed16c22d30a80cf1cab8125981afb9bffa7220548:"
        }
      ]
    },
    {
      "id": "claim_1b9d36a07e834b24accf77e2b2fe344c",
      "statement": "Thread subjects are append-only: Thread.add_subject() in tutoring.domain refuses any attempt to add a fourth subject and never removes subjects; the maximum is 3 subjects per thread; a warning is shown when the thread reaches the maximum.",
      "evidence": [
