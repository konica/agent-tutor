    {
      "id": "claim_52cfae1c8adc421a914e6fa01d57bcae",
      "statement": "The idle-record sweeper is a Kubernetes CronJob that runs every minute; it selects threads where last_learner_message_at < now − learning_record_idle_minutes AND last_learner_message_at > record_written_at, then writes or updates the learning record only (no Lesson Note); only learner messages reset the idle timer; the default is 10 minutes, stored in SSM.",
      "evidence": [
        {
          "resource": "repo://sdd/prd.md#L305-L305",
