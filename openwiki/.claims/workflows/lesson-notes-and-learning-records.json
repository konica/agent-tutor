    {
      "id": "claim_06d29a8cc4b64cfb85aaee56bb2a82cc",
      "statement": "The `learning` module owns Lesson Notes (one per thread, soft-delete only) and lifetime learning records (note trigger and idle trigger); its public API for other modules is `learning.application`, which is the only package other modules may import from it.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/learning/README.md",
          "version": "repo-file-v1:sha256:df2cdf14720ce9750aad8ec090c820bd3b76bee4108bb5e5905b46ad8a49e9bb"
        },
        {
