    {
      "id": "claim_5c8d0790902a466c8f1ed442a4a3f7cd",
      "statement": "A learning record is a lifetime entry per thread in the LangGraph store, namespace `('learning', user_id)`, key = `thread_id`, storing `subject_ids`, `topics`, `key_points`, `note_id`, `trigger`, `learned_at`, and `updated_at`. At most one record exists per thread; it is updated in place by either trigger.",
      "evidence": [
        {
          "resource": "repo://sdd/prd.md#L104-L104",
          "version": "repo-lines-v1:sha256:99a5cb2cee84b3c01dd08af52d2e36ad651ddba15897f48ce899d04406293d21:"
        },
        {
          "resource": "repo://sdd/prd.md#L352-L352",
          "version": "repo-lines-v1:sha256:174ef4cf382ea2625c75dc9dd933257b76710bc0a93be170582f131902488836:"
        }
      ]
    },
    {
      "id": "claim_375508c19f9e4125b1e1a1acc349303b",
      "statement": "Learning records are written by exactly two triggers: (1) the note trigger — when the learner creates or overwrites a Lesson Note via 'Summarize lesson', the agent's `save_learning_record` tool call upserts the note and record together; (2) the idle trigger — the record sweeper CronJob writes or updates the record when a thread has been idle, without creating a note.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/learning/README.md#L9-L9",
          "version": "repo-lines-v1:sha256:da99c148d8b344b1c92cc16bc26260d02d5c299e35bcc572c439f1110b49969f:"
