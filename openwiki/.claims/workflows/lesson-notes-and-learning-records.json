          "version": "repo-lines-v1:sha256:7ac4d861bfdf318c84fa28830502cac346acbc20a4623ee67e7e68fd31e593dc:"
        }
      ]
    },
    {
      "id": "claim_8dc63eb9d42b483593943706447bbf19",
      "statement": "There is exactly one Lesson Note per thread: the `lesson_notes` table uses `thread_id` as a unique key, and notes are never hard-deleted — 'Delete' archives the note (sets `status = archived`), which is reversible via `restore()`.",
      "evidence": [
        {
          "resource": "repo://sdd/prd.md#L103-L104",
          "version": "repo-lines-v1:sha256:3c3e07935075afcb53d5433b157655aee6f7f1771e38a386dca5d6367276b243:"
