  "claims": [
    {
      "id": "claim_39f62d13d03f4678805e9d8cbf0a8d12",
      "statement": "The ingestion worker is triggered by S3 ObjectCreated events delivered via SQS: learners upload via a presigned POST to uploads/<user_id>/<upload_id>.pdf, the S3 event is delivered to SQS, and the worker consumes the SQS message to begin processing.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/apps/worker/main.py#L1-L1",
          "version": "repo-lines-v1:sha256:76e5774c06ec88938022bbb3ffd9be9c83415ad1b7c26bbd2994ec7fddaeb24d:"
        },
        {
          "resource": "repo://sdd/prd.md#L272-L274",
          "version": "repo-lines-v1:sha256:5c32d9f153145276c36ad4e00d81741328af2cb2cd56df1216057df48ae43860:"
