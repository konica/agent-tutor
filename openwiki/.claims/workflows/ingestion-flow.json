    },
    {
      "id": "claim_8b288d9b51424899903d3ceb1968c65f",
      "statement": "The document state machine has four states per learner: `processing` (from upload start), `awaiting_subjects` (when the linked content becomes ready), `ready` (after 1–3 subjects are chosen), and `failed` (if content fails or validation fails). The `archived` flag is orthogonal to state and excludes documents from search.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/knowledge/README.md#L1-L12",
          "version": "repo-lines-v1:sha256:e37ec23ef5a6e64b5055c8e0d24bec2cea4580c9c05be3acd78c0afb47f8855c:"
