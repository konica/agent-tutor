        }
      ]
    },
    {
      "id": "claim_ce626f2216a94bcbb5be62e2755b182c",
      "statement": "Performance targets from PRD §11: subject suggestions shown p95 ≤ 30 s from upload completion (new content); duplicate of a ready content reaches choose-subjects p95 ≤ 10 s; new content searchable p95 ≤ 5 min for ≤ 200 pages and ≤ 15 min for 201–500 pages.",
