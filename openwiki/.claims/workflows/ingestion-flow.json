    },
    {
      "id": "claim_e6ba72caf7e949588cecdba04083f3e9",
      "statement": "Upload rate limits are sourced from SSM Parameter Store and enforced by the accounts module (UsageService). The defaults are 20 uploads per hour and 100 uploads per day per learner; both successful and failed or duplicate uploads count toward these limits. Exceeding a limit returns HTTP 429 with a retry-after message.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/accounts/README.md#L1-L12",
          "version": "repo-lines-v1:sha256:1984e5316c29f41eb35411a5ed4e3130d2e73cf89b5dd1df893dcc3061700dc2:"
