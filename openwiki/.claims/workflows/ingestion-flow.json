        }
      ]
    },
    {
      "id": "claim_a2eecfa349ea45cf87213c690521fb05",
      "statement": "Per-file constraints enforced during ingestion: PDF format only, ≤ 50 MB (checked client-side before upload), ≤ 500 pages and parseability (checked server-side after upload). Failures set the document to `failed` with the reason; the learner sees a Retry button for up to 3 attempts per content.",
      "evidence": [
        {
          "resource": "repo://sdd/prd.md#L170-L173",
          "version": "repo-lines-v1:sha256:3e7153f48148dd70c8c553e3e12c1e1fa811fedbfe0dc3f26d43dddaf1617400:"
