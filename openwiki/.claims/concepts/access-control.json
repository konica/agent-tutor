    {
      "id": "claim_cf8359b08c5d40c4aeb61792cd6e4f03",
      "statement": "The JWT forwarding chain is: Browser completes Authorization Code + PKCE with Keycloak and receives a token with aud including smart-tutor-api and rag-mcp; API validates (JWKS, iss, aud=smart-tutor-api, exp) and forwards the same token to the agent; agent attaches it to every MCP request via HTTP header and runtime context, never in the prompt; MCP server validates again (JWKS, aud includes rag-mcp, exp) and reads sub.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/shared/adapters/auth/__init__.py#L1-L1",
          "version": "repo-lines-v1:sha256:526272e6ed41cf58e31a6590a8ca92445619f0ff049b934efc72a6494db45fb1:"
        },
        {
