    {
      "id": "claim_abbf24ec146048af87c8c0aa3e6a5f19",
      "statement": "Filtered vector search uses pgvector iterative HNSW scan (hnsw.iterative_scan, pgvector >= 0.8) as the primary path, with an exact-search fallback over the learner's own chunks when the readable set is small. Recall@5 target under selective filters is >= 0.95, tested in M1.",
      "evidence": [
