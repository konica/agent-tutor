  "claims": [
    {
      "id": "claim_2bd24c09f1324a89b9dfcbd52a1417cf",
      "statement": "The Content/Document split (ADR 0002) ensures a file is extracted, chunked, and embedded exactly once per unique SHA-256 across all users; the `contents` table has no owner, while `documents` is the per-learner library entry with `owner_id`, subjects, and visibility.",
      "evidence": [
        {
          "resource": "repo://sdd/adr/0002-content-document-split-sha256-dedupe.md",
          "version": "repo-file-v1:sha256:2a0c5ac25be3bf5d4ba4593700ef7908c5fa89843272b49ed1df98743d4fc6bd"
        },
        {
          "resource": "repo://sdd/prd.md#L343-L345",
          "version": "repo-lines-v1:sha256:82e5e17e8efd71e85c3fecd0e0a250548a0d3c68703b29b5c5bc21e9a20098af:"
        }
      ]
    },
    {
      "id": "claim_b20932327e7f4307a1c65970ba54fb8c",
      "statement": "The `contents` table stores `state` (`processing`/`ready`/`failed`), extracted metadata (title, authors, year, doi, work_key, references[]), summary and its embedding, proposed_subject_names[], the embedding model/dimension, processed_by_user_id (for usage attribution), and s3_key/docling_key pointing to the PDF and saved Docling JSON in S3.",
      "evidence": [
        {
          "resource": "repo://sdd/prd.md#L343-L343",
          "version": "repo-lines-v1:sha256:f11fb13445415b70e1c1ea9ee78402e6697b54e33007061bd53c14ad2a69a38c:"
        }
      ]
    },
    {
      "id": "claim_ea66d0f3b8d74c6c8e6e2eb944d59f1e",
      "statement": "The `chunks` table stores content_id, page (nullable), text (preserved to allow re-embedding without Glacier restore), and a 1024-dimensional HNSW vector embedding; chunks belong to the content, not to any learner.",
      "evidence": [
        {
          "resource": "repo://sdd/prd.md#L344-L344",
          "version": "repo-lines-v1:sha256:4473cdec8e978116e9bc39e944f2b02c488d98dc37ddb66b13d36d9926b55084:"
        }
      ]
    },
    {
      "id": "claim_355bcca6b5ef4b57a66c68fe512555bd",
      "statement": "The `documents` table has unique constraint `(owner_id, content_id)` (where content_id is non-null), carries `state` (`processing`/`awaiting_subjects`/`ready`/`failed`), an `archived` boolean flag (soft-delete only), `visibility` (`private` in R1-3; `shared`/`public` in R4), `title_override`, and `added_via`.",
      "evidence": [
        {
          "resource": "repo://sdd/prd.md#L345-L345",
          "version": "repo-lines-v1:sha256:77b879296c6cc99204c1013dfaaca9afc0b670de49affff099a141db3a294106:"
        }
      ]
    },
    {
