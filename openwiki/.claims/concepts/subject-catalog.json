    {
      "id": "claim_2dd4e6dfc0564b4e85fcb718ba8bfca6",
      "statement": "SubjectSuggester ranks subject suggestions using a preference order of: (1) shared catalog subjects matching by cosine similarity to the content summary_embedding, (2) boosted by whether those subjects are already in the learner's My Subjects set, (3) remaining slots filled with model-proposed names from describe_document that do not match any existing subject. This implements the PRD D20 ordering: matching shared subjects first, then the learner's subjects, then new names.",
      "evidence": [
