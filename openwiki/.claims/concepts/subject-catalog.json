    {
      "id": "claim_7000cd59558a4f1f900f5cdd67ec2af9",
      "statement": "The new-name pipeline for subject catalog entries proceeds in six ordered steps: trim whitespace, enforce the 60-character limit, normalize (casefold, Unicode NFKC, collapse whitespace), near-duplicate reuse via embedding similarity (SubjectCatalogService returns existing subject if a close match is found), personal-data/offensive-content check via SubjectNameChecker (calls amazon.nova-2-lite-v1:0 check_subject_name tool; stub at M1), and immediate catalog insertion with no approval queue.",
      "evidence": [
        {
          "resource": "repo://backend/src/smart_tutor/subjects/README.md",
          "version": "repo-file-v1:sha256:f28366aa82df793837b080b7d48e01ec6f2ce43e606a8d1bb41c45621143bb13"
